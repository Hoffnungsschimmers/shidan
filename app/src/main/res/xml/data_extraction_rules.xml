<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="photos/" />
        <exclude domain="database" path="meal_note.db" />
        <!-- mealnote_webdav 存有 WebDAV 账号密码，禁止随云备份/设备迁移离开设备（AGENTS §6） -->
        <exclude domain="sharedpref" path="mealnote_webdav.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="photos/" />
        <exclude domain="database" path="meal_note.db" />
        <exclude domain="sharedpref" path="mealnote_webdav.xml" />
    </device-transfer>
</data-extraction-rules>
